# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/outreach?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# Enable the Gmail API. Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32-byte key used to encrypt each user's Apollo/Hunter/Anthropic keys at rest
# run: openssl rand -hex 32
ENCRYPTION_KEY=""

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# Optional: server-wide fallbacks if a user hasn't saved their own keys
APOLLO_API_KEY=""
HUNTER_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
